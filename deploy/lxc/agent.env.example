# Lighthouse agent configuration. Copy to /etc/lighthouse/agent.env.
#
# Everything is one variable because systemd's ExecStart expands it unquoted,
# which is what lets the argument list vary by deployment without a different
# unit file per host.

# Cron schedules are read in this zone.
TZ=America/Chicago

# --- Choose the deployment that matches this host ---

# A. Running ON the Proxmox node. pct and pvesh are local, so no ssh is needed.
#    Covers node packages, guest packages and OCI image drift.
LIGHTHOUSE_ARGS=--schedule="0 0 4 * * *" --node=pve1

# B. Running in an LXC or OCI guest, watching the node it sits on. pct and
#    pvesh cannot exist in a container, so the commands go over ssh.
# LIGHTHOUSE_ARGS=--schedule="0 0 4 * * *" --node=pve1 --ssh-host=root@192.168.1.10 --ssh-key=/etc/lighthouse/id_ed25519

# C. Just this machine's own packages.
# LIGHTHOUSE_ARGS=--schedule="0 0 4 * * *" --host-packages

# Add --apply to install updates. Without it nothing is changed, which is the
# right setting until you have read a few reports.
# The node is never rebooted either way; a pending reboot is reported.
